    {
      "parameters": {
        "jsCode": "// Unwrap Anthropic's envelope\nconst anthropicResponse = $input.first().json;\nconst rawText = anthropicResponse.content[0].text;\n\n// Defensive extraction: find the first { and the last } to grab just the JSON\nconst firstBrace = rawText.indexOf('{');\nconst lastBrace = rawText.lastIndexOf('}');\n\nif (firstBrace === -1 || lastBrace === -1) {\n  throw new Error('No JSON object found in Claude response: ' + rawText);\n}\n\nconst jsonString = rawText.substring(firstBrace, lastBrace + 1);\n\n// Parse the extracted JSON\nconst report = JSON.parse(jsonString);\n\nreturn [{ json: report }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -144
      ],
      "id": "d4179195-553e-43b8-8fdc-54679f0a0a97",
      "name": "Parse Claude Response"
    },
    {
      "parameters": {
        "jsCode": "// Pull all upstream rows\nconst rows = $input.all().map(item => item.json);\n\n// Build the body as a real JS object\nconst body = {\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 1024,\n  messages: [\n    {\n      role: \"user\",\n      content: `Generate a daily sales report for SightCo Optical from the raw data below. Return ONLY a valid JSON object, no preamble, no markdown fences. The JSON object must contain these fields: total_revenue as a number (sum of revenue_sgd across all rows), total_transactions as a number (sum of transactions), total_walk_ins as a number (sum of walk_ins), top_performer_name as a string (the staff_name with the highest revenue_sgd), top_performer_revenue as a number, match and find duplicates for top_performer_revenue, top_performer_transactions as a number, top_category as a string (the most frequent value in top_category column), and issues as a string (one-sentence summary of the notes column across all rows, or the literal text No issues reported if notes are empty or trivial). Raw data: ${JSON.stringify(rows)}`\n    }\n  ]\n};\n\n// Return the body wrapped for n8n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -128
      ],
      "id": "b6ea3301-7752-4bbe-8a75-b3b79bcbae9e",
      "name": "Stringify() Body to Claude"
    },
    {
      "parameters": {
        "jsCode": "const report = $input.first().json;\n\nconst message = `📊 SightCo Daily Sales Report\n\n💰 Total Revenue: SGD ${report.total_revenue}\n🛍️ Total Transactions: ${report.total_transactions}\n🚶 Walk-ins: ${report.total_walk_ins}\n\n🏆 Top Performer: ${report.top_performer_name} — SGD ${report.top_performer_revenue} / ${report.top_performer_transactions} txns\n📈 Top Category: ${report.top_category}\n\n⚠️ Issues: ${report.issues}\n\n— SightCo Reporter`;\n\nreturn [{ json: { message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
