      ],
      "id": "90c84a8f-9800-499d-9a86-bdf3821f13e2",
      "name": "Update a contact",
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "F1QCIlrQKPhMMPd8",
          "name": "Salesforce account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Grab the contact from Salesforce\nconst contact = $input.first().json;\n\nconst firstName = contact.FirstName || '';\nconst lastName = contact.LastName || '';\nconst email = contact.Email || '';\n\n// Build the Claude request body\nconst body = {\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 1024,\n  messages: [\n    {\n      role: \"user\",\n      content: `You are a B2B lead enrichment assistant. Below is a raw CRM contact. Infer likely firmographic context FROM THE EMAIL DOMAIN ONLY. These are educated guesses, not verified facts — mark them as inferred and do not fabricate specific numbers.\n\nReturn ONLY a valid JSON object (no preamble, no markdown fences) with these fields:\n- inferred_company: likely company name based on the email domain\n- inferred_industry: likely industry\n- company_size_guess: one of \"Small\", \"Mid-market\", or \"Enterprise\"\n- outreach_angle: one concise sentence suggesting an opening angle for sales outreach, based on likely industry pain points\n\nContact:\nFirst name: ${firstName}\nLast name: ${lastName}\nEmail: ${email}`\n    }\n  ]\n};\n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -64
      ],
      "id": "9cb39d4b-fc85-4989-b1f4-a4c9181d708e",
      "name": "Build Enrichment Body"
    },
    {
      "parameters": {
        "jsCode": "const anthropicResponse = $input.first().json;\nconst rawText = anthropicResponse.content[0].text;\n\nconst firstBrace = rawText.indexOf('{');\nconst lastBrace = rawText.lastIndexOf('}');\nif (firstBrace === -1 || lastBrace === -1) {\n  throw new Error('No JSON object found in Claude response: ' + rawText);\n}\n\nconst jsonString = rawText.substring(firstBrace, lastBrace + 1);\nreturn [{ json: JSON.parse(jsonString) }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
